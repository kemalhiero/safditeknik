<%- include('./modals/header.ejs') %> 

<%- include('./modals/sidebar.ejs') %> 

    <main id="main" class="main">
        <section class="section dashboard">
            <!-- ===== TEMPLATE ===== -->
            <section class="section">
                <div class="row">
                    <div class="col-lg-12">

                        <div class="card">
                            <div class="card-body">
                                <!-- <h5 class="card-title">Identitas Teknisi</h5>
                                <div class="row">
                                    <div class="col-md-4">Nama</div>
                                    <div class="col-md-8">lorem</div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">No HP</div>
                                    <div class="col-md-8">lorem</div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">Alamat</div>
                                    <div class="col-md-8">lorem</div>
                                </div> -->
                                <br>

                                <!-- Table with stripped rows -->
                                <table class="table datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Name Barang</th>
                                            <th scope="col">Deskripsi</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% barang.forEach(function(brg, index) { %>
                                        <tr>
                                            <th scope="row"><%= index+1 %></th>
                                            <td><%= brg.nama_barang %></td>
                                            <td><%= brg.deskripsi %></td>
                                            <td>
                                                <% if (brg.status=="" || brg.status==null) { %>
                                                    Sedang Diperbaiki
                                                <% } else{%>
                                                    <%= brg.status %> 
                                                <% } %> 
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                                                    data-bs-target="#basicModal<%= index+1 %>">
                                                    Edit Status
                                                </button></td>

                                                <div class="modal fade" id="basicModal<%= index+1 %>" tabindex="-1">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <form action="/teknisi/ubahStatus" method="post">
                                                                <input type="hidden" name="id_barang" value="<%= brg.id %>">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">Ganti Status</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                    aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row mb-3">
                                                                    <select class="form-select" aria-label="Default select example" name="status">
                                                                        <option selected>Pilih Status</option>
                                                                        <option value="">Sedang diperbaiki</option>
                                                                        <option value="Tidak bisa diperbaiki">Tidak bisa diperbaiki</option>
                                                                        <option value="Selesai diperbaiki">Selesai diperbaiki</option>
                                                                      </select>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                                <button type="submit" class="btn btn-primary">Edit</button>
                                                            </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                                <!-- End Table with stripped rows -->

                            </div>
                        </div>

                    </div>
                </div>
            </section>





            <!-- ===== END OF TEMPLATE ===== -->
        </section>
    </main>

<%- include('./modals/js.ejs') %> 

