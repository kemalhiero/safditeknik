<%- include('./modals/header.ejs') %> 

<%- include('./modals/sidebar.ejs') %> 

    <main id="main" class="main">
        <section class="section">
            <div class="row">
                <div class="col-lg-12">

                    <div class="card">
                        <div class="card-body"><br>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#basicModal">
                                    Tambah Pelanggan
                            </button>

                            <div class="modal fade" id="basicModal" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Tambah Pelanggan</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                aria-label="Close"></button>
                                        </div>
                                        <form action="/admin/tambahPelanggan" method="post">
                                            <div class="modal-body">
                                                <div class="row mb-3">
                                                    <label for="inputEmail3" class="col-sm-2 col-form-label">Nama</label>
                                                    <div class="col-sm-10">
                                                        <input type="text" class="form-control" id="inputText" name="name" required>
                                                    </div>
                                                    <label for="inputEmail3" class="col-sm-2 col-form-label">No HP</label>
                                                    <div class="col-sm-10">
                                                        <input type="number" class="form-control" id="inputText" name="no_hp" required>
                                                    </div>
                                                    <label for="inputEmail3" class="col-sm-2 col-form-label">Alamat</label>
                                                    <div class="col-sm-10">
                                                        <input type="text" class="form-control" id="inputText" name="alamat" required>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-primary">Tambah</button>
                                            </div>   
                                        </form>
                                    </div>
                                </div>
                            </div><!-- End Basic Modal-->

                            <table class="table datatable">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Name</th>
                                        <th scope="col">No HP</th>
                                        <th scope="col">Alamat</th>
                                        <th scope="col">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% pelanggan.forEach(function(plgn, index) { %>
                                    <tr>
                                        <th scope="row">1</th>
                                        <td><%= plgn.nama %></td>
                                        <td><%= plgn.no_hp %></td>
                                        <td><%= plgn.alamat%></td>
                                        <td>
                                            <a href="/admin/tambahBarang-<%= plgn.id %>" class="btn btn-primary">Tambah</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                            <!-- End Table with stripped rows -->

                        </div>
                    </div>

                </div>
            </div>
        </section>
    </main>

<%- include('./modals/js.ejs') %> 

